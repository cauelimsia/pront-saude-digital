# ─── Produção (VPS + Docker) ──────────────────────────────────────────────
# Copie para .env NA RAIZ do projeto na VPS e preencha. NUNCA versione o .env.
# Gere segredos fortes com:  openssl rand -base64 48

# Domínio (com DNS apontando para o IP da VPS). O Caddy emite o HTTPS sozinho.
DOMAIN=surebets.seudominio.com

# Banco (senha forte, só usada internamente entre os containers).
POSTGRES_USER=rataria
POSTGRES_PASSWORD=TROQUE_por_uma_senha_forte
POSTGRES_DB=rataria

# Autenticação — OBRIGATÓRIO e forte (>= 32 chars). openssl rand -base64 48
JWT_SECRET=TROQUE_por_um_segredo_forte_de_no_minimo_32_caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Admin inicial (opcional). Gere o HASH (nunca a senha em texto) com:
#   docker compose run --rm api node -e "require('@node-rs/argon2').hash(process.argv[1]).then(h=>console.log(h))" 'SUA_SENHA'
# SEED_ADMIN_EMAIL=admin@seudominio.com
# SEED_ADMIN_PASSWORD_HASH=$argon2id$v=19$...

# Provedor real de odds (opcional) — API-Football. Deixe vazio p/ rodar só mocks.
# REST_PROVIDER_API_KEY=sua-chave-rotacionada
REST_PROVIDER_ID=api-football
REST_PROVIDER_BASE_URL=https://v3.football.api-sports.io
REST_PROVIDER_AUTH_NAME=x-apisports-key

# Pipeline
INGESTION_INTERVAL_MS=15000
OPPORTUNITY_TTL_MS=120000
