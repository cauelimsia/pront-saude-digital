# Copie para .env e ajuste. NUNCA versione o .env real.

# PostgreSQL
DATABASE_URL=postgresql://rataria:rataria@localhost:5432/rataria

# Redis (filas BullMQ + pub/sub de tempo real)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# Pipeline
INGESTION_INTERVAL_MS=15000
MAX_ODDS_AGE_MS=90000
OPPORTUNITY_TTL_MS=120000
MIN_PROFIT_PERCENT=0.1
REFERENCE_BANKROLL=1000
MOCK_VARIABILITY=false
LOG_LEVEL=info

# Ambiente
NODE_ENV=development

# Autenticação (Fase 7)
# Em produção, JWT_SECRET é OBRIGATÓRIO e deve ter ≥ 32 caracteres (loadEnv
# falha na inicialização caso contrário). O valor abaixo é apenas para dev.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-000
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Usuário admin de bootstrap (opcional): o seed cria/garante este ADMIN se as
# duas variáveis estiverem definidas. O hash é gerado com a API (argon2), nunca
# a senha em texto puro. Ex.: gere o hash via POST /auth/register + UPDATE role.
# SEED_ADMIN_EMAIL=admin@rataria.dev
# SEED_ADMIN_PASSWORD_HASH=$argon2id$v=19$...
