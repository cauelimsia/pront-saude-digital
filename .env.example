# Copie para .env e ajuste. NUNCA versione o .env real.

# PostgreSQL
DATABASE_URL=postgresql://rataria:rataria@localhost:5432/rataria

# Redis (filas BullMQ + pub/sub de tempo real)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# Pipeline
INGESTION_INTERVAL_MS=15000
MAX_ODDS_AGE_MS=90000
OPPORTUNITY_TTL_MS=120000
MIN_PROFIT_PERCENT=0.1
REFERENCE_BANKROLL=1000
MOCK_VARIABILITY=false
LOG_LEVEL=info

# Ambiente
NODE_ENV=development

# Proteção TEMPORÁRIA da revisão de matching (Fase 4, ADR-0012).
# true só fora de produção — loadEnv FALHA se true em NODE_ENV=production.
# Será substituída por autenticação com RBAC na Fase 7.
ENABLE_UNAUTHENTICATED_MATCH_REVIEW=false
